# ========================================
# RAG Knowledge Base System - Environment Variables
# All configuration via environment variables only.
# No local config files. No hardcoded values.
# Copy this file to .env and fill in your values.
# ========================================

# ---- Application ----
APP_NAME=rag-kb-system
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# ---- CORS ----
# 逗号分隔的前端域名列表，生产环境必须配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- JWT Authentication ----
JWT_SECRET_KEY=  # 必须配置！至少32位随机字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- MySQL Database ----
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_kb

# ---- Milvus Vector DB ----
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_NPROBE=16

# ---- Alibaba Tongyi Embedding API ----
TONGYI_API_KEY=your-tongyi-api-key-here
TONGYI_EMBEDDING_MODEL=text-embedding-v3
TONGYI_EMBEDDING_DIMENSIONS=1024
TONGYI_EMBEDDING_TOKEN_PRICE=0.0008
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- DeepSeek LLM Chat API ----
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_INPUT_TOKEN_PRICE=0.0010
DEEPSEEK_OUTPUT_TOKEN_PRICE=0.0020
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- File Upload Constraints ----
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,doc,pptx,ppt,txt,md,xlsx,xls,csv

# ---- Chunking Defaults (user can override per upload) ----
DEFAULT_CHUNK_STRATEGY=fixed_token
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=128
DEFAULT_CHUNK_SEPARATORS=\n\n,\n,.,;,,\u3001,\u3002

# ---- RAG Retrieval Parameters ----
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.6
RAG_RETRIEVE_MODE=mix  # vector | keyword | mix

# ---- SSE Streaming ----
SSE_TIMEOUT_MS=120000

# ---- Initial Super Admin (auto-created on first startup) ----
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=  # 必须配置！至少8位字符
INIT_ADMIN_REAL_NAME=超级管理员
INIT_ADMIN_EMAIL=admin@rag.local
