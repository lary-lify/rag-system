# ============================================================
# rag-kb-system 环境配置模板
# 复制本文件为 .env 并填入真实值后启动（变量名与代码一一对应）
# ============================================================

# ---- Application ----
APP_NAME=rag-kb-system
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- JWT ----
JWT_SECRET_KEY=please-set-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_kb

# ---- Milvus Vector DB ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_NPROBE=16

# ---- Alibaba Tongyi Embedding API ----
TONGYI_API_KEY=your-tongyi-api-key
TONGYI_EMBEDDING_MODEL=text-embedding-v3
TONGYI_EMBEDDING_DIMENSIONS=1024
TONGYI_EMBEDDING_TOKEN_PRICE=0.0008
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- DeepSeek LLM Chat API ----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_INPUT_TOKEN_PRICE=0.0010
DEEPSEEK_OUTPUT_TOKEN_PRICE=0.0020
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Redis (optional, for future rate-limit/cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- File Upload ----
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,doc,pptx,ppt,txt,md,xlsx,xls,csv
UPLOAD_DIR=/app/data/uploads
CRAWL_DIR=/app/data/crawls

# ---- Chunking defaults ----
DEFAULT_CHUNK_STRATEGY=fixed_token
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=128

# ---- RAG retrieval ----
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
RAG_RETRIEVE_MODE=mix

# ---- SSE streaming ----
SSE_TIMEOUT_MS=120000

# ---- Initial super admin ----
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me
INIT_ADMIN_REAL_NAME=超级管理员
INIT_ADMIN_EMAIL=admin@rag.local


# ==========================================================
# 以下条目由 scripts/gen_env_example.py 从 config.py 自动补全。
# 值与注释均取自代码默认值，按需覆盖。
# ==========================================================

# ---------- File Upload ----------
# 上传暂存目录名。流式写盘的临时文件不再与正式文件混放在 UPLOAD_DIR
# 根下，而是单独收进这个子目录：混放时一旦进程被 kill（OOM、强制重启），
# finally 来不及执行，残骸就是一堆散落在正式文件里的 .upload 文件，
# 既没法一眼分辨，清理时也要遍历整个 uploads 并靠扩展名猜。
UPLOAD_STAGING_SUBDIR=.staging
# 上传暂存目录名。流式写盘的临时文件不再与正式文件混放在 UPLOAD_DIR
# 根下，而是单独收进这个子目录：混放时一旦进程被 kill（OOM、强制重启），
# finally 来不及执行，残骸就是一堆散落在正式文件里的 .upload 文件，
# 既没法一眼分辨，清理时也要遍历整个 uploads 并靠扩展名猜。
UPLOAD_STAGING_MAX_AGE_SECONDS=3600

# ---------- RAG retrieval ----------
# RAG_TOP_K 是每个知识库各自的召回上限，也是「最终喂给 LLM 的片段数」的
# 默认上限。跨 N 个知识库检索时，各库各召回 RAG_TOP_K 条，合并后最多
# RAG_TOP_K x N 条——全部进 prompt 会稀释注意力（lost-in-the-middle）
# 并推高 cost，因此合并后还要再做一次全局截断。
# 合并后全局保留的片段数上限。<=0 表示不截断（保留旧行为）。
RAG_GLOBAL_TOP_K=5

# ---------- Deployment / 进程模型 ----------
# gunicorn worker 数。连接池容量按 worker 数推算，多副本部署时必须与实际一致，
# 否则会放大 MySQL 连接数（worker 数 x 单 worker 池上限）。
APP_WORKERS=2
# gunicorn worker 数。连接池容量按 worker 数推算，多副本部署时必须与实际一致，
# 否则会放大 MySQL 连接数（worker 数 x 单 worker 池上限）。
# SQL_ECHO=   # 默认值 None，无法用空串表示，需要时显式写成 true/false

# ---------- MySQL 连接池 ----------
DB_POOL_SIZE_PER_WORKER=5
DB_MAX_OVERFLOW_PER_WORKER=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# MySQL 侧 max_connections 的预算上限，仅用于启动期核对与告警。
# MySQL 社区版默认 151，改过服务端配置后同步改这里，否则告警会误报。
# 留够余量：应用之外还有管理连接、其他服务与备份任务会占用连接。
DB_MAX_CONNECTIONS_BUDGET=151

# ---------- 共享 HTTP 连接池（DeepSeek / Tongyi 等外部 API） ----------
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=50
HTTP_KEEPALIVE_EXPIRY=30.0
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=60.0

# ---------- Milvus ----------
# pymilvus 是同步客户端，调用统一丢线程池，池大小直接决定向量读写并发上限。
MILVUS_POOL_WORKERS=8
# pymilvus 是同步客户端，调用统一丢线程池，池大小直接决定向量读写并发上限。
# 查询后是否释放集合。默认 False：集合加载后常驻，避免每次查询重复 load。
MILVUS_AUTO_RELEASE=false
# pymilvus 是同步客户端，调用统一丢线程池，池大小直接决定向量读写并发上限。
# 查询后是否释放集合。默认 False：集合加载后常驻，避免每次查询重复 load。
# 关闭时等待在途向量读写完成的最长时间（秒）。必须小于 gunicorn 的
# --graceful-timeout（默认 30s），否则优雅关闭窗口会先被耗尽，进程被
# SIGKILL，等待逻辑形同虚设。留 10s 余量给 HTTP 连接池与 DB 关闭。
MILVUS_SHUTDOWN_TIMEOUT=20.0

# ---------- Embedding 调用 ----------
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY=1.0
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400
# 缓存的是 1024 维向量，单条约 32KB（Python float 列表），
# 1000 条约 32MB/进程。多 worker 部署时需按 worker 数折算内存。
EMBEDDING_CACHE_MAX_SIZE=1000

# ---------- 查询改写 ----------
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_CACHE_ENABLED=true
QUERY_REWRITE_CACHE_TTL=3600
QUERY_REWRITE_CACHE_MAX_SIZE=2000
# 改写是挡在检索之前的同步等待，这里的每一秒都会原样叠加到用户感知的
# 首字延迟上（命中缓存时则完全不耗时）。8s 意味着一次外部 API 抖动就能
# 让对话开头卡住近 10 秒，而改写的收益（召回略微变好）远不值这个代价。
QUERY_REWRITE_TIMEOUT=3.0


# ==========================================================
# 以下条目由 scripts/gen_env_example.py 从 config.py 自动补全。
# 值与注释均取自代码默认值，按需覆盖。
# ==========================================================

# ---------- Redis (optional, for cache / future rate-limit) ----------
# Redis 连接串。CACHE_BACKEND=redis 时作为共享缓存后端；主请求链路缓存
# 通过 app.core.cache 的同步客户端接入（与 TTLCache 同接口，调用方零改动）。
# 缓存后端：memory=进程内（默认，单机/少 worker 零依赖）；
# redis=共享缓存（多副本共享、重启不丢，需自备 Redis 服务，compose.full 已含）。
# 连不上 Redis 时自动降级 memory 并告警，不阻塞启动。
CACHE_BACKEND=memory
